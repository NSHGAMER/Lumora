# ==============================================================================
# LUMORA CAMPUS OS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Safe template for local development, testing, and production deployments.
# DO NOT store real production secrets in this file or commit real .env files.
# ==============================================================================

# Application Environment (development | testing | production)
LUMORA_ENV=development

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Allowed CORS Origins (JSON list or comma-separated strings)
# Wildcards are strictly rejected in production mode
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Future Phase 2B.2 — MongoDB Atlas Persistence Placeholders
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=lumora_db

# ------------------------------------------------------------------------------
# Future Phase 2B.3 — Authentication & JWT Security Placeholders
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=lumora-insecure-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
