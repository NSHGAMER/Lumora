# ==============================================================================
# LUMORA CAMPUS OS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Safe template for local development, testing, and production deployments.
# DO NOT store real production secrets in this file or commit real .env files.
# ==============================================================================

# Application Environment (development | testing | production)
LUMORA_ENV=development

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Allowed CORS Origins (JSON list or comma-separated strings)
# Wildcards are strictly rejected in production mode
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Phase 2B.2 — MongoDB Atlas Persistence Configuration Placeholders
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DATABASE=lumora

# ------------------------------------------------------------------------------
# Phase 2B.3 — Authentication & JWT Security Placeholders
# ------------------------------------------------------------------------------
# For production, supply a random cryptographically secure string (min 32 chars):
# e.g., generated with: openssl rand -hex 32
JWT_SECRET_KEY=<development-secret-placeholder-minimum-32-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=lumora
JWT_AUDIENCE=lumora-client
